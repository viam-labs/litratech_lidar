{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam-labs:litratech-lidar",
  "visibility": "public",
  "url": "https://github.com/viam-labs/litratech_lidar",
  "description": "Camera component for LitraTech LDCP 2D lidars",
  "models": [
    {
      "api": "rdk:component:camera",
      "model": "viam-labs:lidar:litratech",
      "markdown_link": "README.md"
    }
  ],
  "markdown_link": "README.md",
  "entrypoint": "run.sh",
  "build": {
    "setup": "./setup.sh",
    "build": "make module.tar.gz",
    "path": "module.tar.gz",
    "arch": ["linux/amd64", "linux/arm64", "darwin/arm64"],
    "distro": "bullseye",
    "darwin_deps": ["cmake", "ninja", "pkg-config", "boost", "grpc", "protobuf", "abseil"]
  }
}
